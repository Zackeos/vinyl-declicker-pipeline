# Web UI port. Defaults to 8080 when unset.
PORT=8080

# Every key in settings.json can be overridden with VINYL_<KEY>.
# Front panel serial port and baud rate (the app runs fine with no panel):
#VINYL_SERIAL_PORT=/dev/ttyACM0
#VINYL_SERIAL_BAUD=9600
# Semicolon-separated name fragments preferred when auto-selecting a device
# (semicolons because ALSA names contain commas, e.g. hw:1,0):
#VINYL_PREFERRED_DEVICES=pipewire;default
